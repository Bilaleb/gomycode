    // script.js
(function() {
  // ----- DOM references -----
  const body = document.body;
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  const themeText = document.getElementById('themeText');

  // ----- helper: update UI based on theme -----
  function setTheme(theme) {
    if (theme === 'dark') {
      body.classList.add('dark');
      themeIcon.textContent = '🌙';
      themeText.textContent = 'Dark';
      localStorage.setItem('gallery-theme', 'dark');
    } else {
      body.classList.remove('dark');
      themeIcon.textContent = '☀️';
      themeText.textContent = 'Light';
      localStorage.setItem('gallery-theme', 'light');
    }
  }

  // ----- initialise theme from localStorage or system preference -----
  function initTheme() {
    const storedTheme = localStorage.getItem('gallery-theme');
    if (storedTheme === 'dark') {
      setTheme('dark');
    } else if (storedTheme === 'light') {
      setTheme('light');
    } else {
      // fallback to system preference
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      setTheme(prefersDark ? 'dark' : 'light');
    }
  }

  // ----- toggle event -----
  themeToggle.addEventListener('click', () => {
    const isDark = body.classList.contains('dark');
    setTheme(isDark ? 'light' : 'dark');
  });

  // ----- optional: listen to system changes if no stored preference -----
  // (only for better UX; if a user has manually chosen a theme we keep it)
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    const stored = localStorage.getItem('gallery-theme');
    // only auto-update if the user hasn't set a manual preference
    if (!stored) {
      setTheme(e.matches ? 'dark' : 'light');
    }
  });

  // ----- run initialisation -----
  initTheme();

  // (fade-in animations are purely CSS, no additional JS needed)
})();
