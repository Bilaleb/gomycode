                    <img src="https://via.placeholder.com/400x250" alt="Smart Watch">
                    <div class="product-info">
                        <h3>Smart Watch</h3>
                        <p>Track your fitness, heart rate, and receive notifications on the go.</p>
                        <button class="shop-btn">Shop Now</button>
                    </div>
                </div>

                <!-- Product Card 3 -->
                <div class="product-card">
                    <img src="https://via.placeholder.com/400x250" alt="Mechanical Keyboard">
                    <div class="product-info">
                        <h3>Mechanical Keyboard</h3>
                        <p>RGB backlit mechanical keyboard with tactile switches for typing.</p>
                        <button class="shop-btn">Shop Now</button>
                    </div>
                </div>

                <!-- Product Card 4 -->
                <div class="product-card">
                    <img src="https://via.placeholder.com/400x250" alt="Bluetooth Speaker">
                    <div class="product-info">
                        <h3>Bluetooth Speaker</h3>
