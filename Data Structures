# PROBLEM 2: Dot Product & Orthogonality Check
# ==========================================

# Procedure approach (passing reference via a list container)
def dot_product_proc(v1, v2, size, ps_ref):
    ps_ref[0] = 0
    for i in range(size):
        ps_ref[0] += v1[i] * v2[i]

def check_orthogonality_procedure(pairs_v1, pairs_v2, n, size):
    print("--- Orthogonality Check (Using Procedure) ---")
    for i in range(n):
        ps = [0]
        dot_product_proc(pairs_v1[i], pairs_v2[i], size, ps)
        if ps[0] == 0:
            print(f"Pair {i+1}: Orthogonal (ps = 0)")
        else:
            print(f"Pair {i+1}: Not orthogonal (ps = {ps[0]})")

# Function approach
def dot_product_func(v1, v2, size):
    ps = 0
    for i in range(size):
        ps += v1[i] * v2[i]
    return ps

def check_orthogonality_function(pairs_v1, pairs_v2, n, size):
    print("\n--- Orthogonality Check (Using Function) ---")
    for i in range(n):
        ps = dot_product_func(pairs_v1[i], pairs_v2[i], size)
        if ps == 0:
            print(f"Pair {i+1}: Orthogonal (ps = 0)")
        else:
            print(f"Pair {i+1}: Not orthogonal (ps = {ps})")


