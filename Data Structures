def find_distinct_sum(set1, set2):
    total_sum = 0
    
    # 1. Compare each element of set 1 with set 2; if not present, add to sum
    for i in range(len(set1)):
        is_present = False
        for j in range(len(set2)):
            if set1[i] == set2[j]:
                is_present = True
                break
        if not is_present:
            total_sum += set1[i]
            
    # 2. Do the vice versa for elements in set 2 compared with set 1
    for i in range(len(set2)):
        is_present = False
        for j in range(len(set1)):
            if set2[i] == set1[j]:
                is_present = True
                break
        if not is_present:
            total_sum += set2[i]
            
    return total_sum

