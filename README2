<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Savory Bistro | Premium Dining</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Custom External CSS -->
  <link rel="stylesheet" href="style.css">
  <script src="script.js" defer></script>
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
      <a class="navbar-brand" href="#home"><i class="bi bi-egg-fried me-2"></i>THE SAVORY BISTRO</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link active" href="#home">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#menu">Menu</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#about">About Us</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact">Contact</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header id="home" class="hero-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <span class="text-uppercase tracking-widest text-warning fw-semibold mb-2 d-inline-block" style="letter-spacing: 3px;">Crafted With Passion</span>
          <h1 class="display-2 fw-bold mb-4">An Unforgettable Culinary Journey</h1>
          <a href="#menu" class="btn hero-btn btn-lg">DISCOVER OUR MENU</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Menu Section -->
  <section id="menu" class="section-padding">
    <div class="container">
      <div class="text-center">
        <h2 class="section-title display-5">Our Signature Dishes</h2>
        <p class="lead text-muted mb-5">Carefully selected ingredients prepared fresh daily by our master chefs.</p>
      </div>
      <!-- Responsive Grid Layout -->
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <!-- Item 1 -->
        <div class="col">
          <div class="card h-100 menu-card">
            <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=800" class="card-img-top" alt="Smoked Salmon Salad">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <h3 class="h4 card-title mb-2">Smoked Salmon Salad</h3>
                <p class="card-text text-muted">Premium Norwegian smoked salmon served over a bed of baby arugula, avocado, cherry tomatoes, and citrus vinaigrette.</p>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="menu-price">$18.00</span>
                <span class="badge bg-light text-dark border"><i class="bi bi-star-fill text-warning me-1"></i>Best Seller</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Item 2 -->
        <div class="col">
          <div class="card h-100 menu-card">
            <img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?q=80&w=800" class="card-img-top" alt="Truffle Butter Tagliatelle">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <h3 class="h4 card-title mb-2">Truffle Butter Tagliatelle</h3>
                <p class="card-text text-muted">House-made egg pasta tossed in a velvety white truffle and Parmigiano-Reggiano sauce, topped with shaved fresh black truffles.</p>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="menu-price">$26.00</span>
                <span class="badge bg-light text-dark border">Chef Spec</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Item 3 -->
        <div class="col">
          <div class="card h-100 menu-card">
            <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=800" class="card-img-top" alt="Wood-Fired Neapolitan Pizza">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <h3 class="h4 card-title mb-2">Artisan Neapolitan Pizza</h3>
                <p class="card-text text-muted">San Marzano tomato base, creamy fresh buffalo mozzarella, fragrant basil leaves, and a drizzle of extra virgin olive oil.</p>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="menu-price">$16.50</span>
                <span class="badge bg-light text-dark border">Classic</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Us Section -->
  <section id="about" class="section-padding bg-white">
    <div class="container">
      <!-- Two-column Responsive Grid Layout -->
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <img src="https://images.unsplash.com/photo-1552566626-52f8b828add9?q=80&w=800" class="about-img" alt="Bistro Interior">
        </div>
              <h4 class="mb-0 fw-bold text-dark">100%</h4>
              <small class="text-muted">Fresh Ingredients</small>
            </div>
            <div class="border-start ps-4">
              <h4 class="mb-0 fw-bold text-dark">Local</h4>
              <small class="text-muted">Sustainable Sourcing</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section-padding">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
          <h2 class="section-title display-5">Reserve A Table</h2>
          <p class="text-muted mb-5">Have any questions or looking to book a private event? Send us a message and we'll get right back to you.</p>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <form class="row g-4">
            <div class="col-md-6">
              <label for="name" class="form-label fw-semibold">Your Name</label>
              <input type="text" class="form-control" id="name" placeholder="John Doe" required>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label fw-semibold">Email Address</label>
              <input type="email" class="form-control" id="email" placeholder="john@example.com" required>
            </div>
            <div class="col-12">
              <label for="message" class="form-label fw-semibold">Your Message</label>
              <textarea class="form-control" id="message" rows="5" placeholder="Tell us how we can help..." required></textarea>
            </div>
            <div class="col-12 text-center">
              <button type="submit" class="btn submit-btn btn-lg shadow-sm">Send Message</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="text-center text-lg-start">
    <div class="container">
      <div class="row align-items-center justify-content-between g-4">
        <div class="col-lg-4 text-center text-lg-start">
          <p class="mb-0">&copy; 2026 The Savory Bistro. All rights reserved.</p>
        </div>
        <div class="col-lg-4 text-center">
          <span class="fs-5 fw-bold text-light">The Savory Bistro</span>
        </div>
        <div class="col-lg-4 text-center text-lg-end">
          <div class="d-flex justify-content-center justify-content-lg-end gap-3">
            <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle p-2 text-white border-0"><i class="bi bi-facebook"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle p-2 text-white border-0"><i class="bi bi-instagram"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm rounded-circle p-2 text-white border-0"><i class="bi bi-twitter-x"></i></a>
          </div>
        </div>
      </div>
    </div>
  </footer>
</body>

css

*
:root {
  --primary-color: #8c2f1b; /* Deep terracotta red */
  --secondary-color: #dca755; /* Warm gold */
  --dark-color: #1a1513; /* Rich dark brown */
  --light-color: #fcfaf7; /* Off-white cream */
}

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background-color: var(--light-color);
  color: #4a403a;
}

h1, h2, h3, h4, .navbar-brand {
  font-family: 'Playfair Display', serif;
  font-weight: 700;
}

/* Custom Navbar styling with Flexbox */
.navbar {
  background-color: rgba(26, 21, 19, 0.95) !important;
  backdrop-filter: blur(5px);
  padding: 1rem 0;
}

.navbar-brand {
  color: var(--secondary-color) !important;
  font-size: 1.6rem;
  letter-spacing: 1px;
}

.nav-link {
  color: #e0d9d5 !important;
  font-weight: 500;
  margin-left: 1.5rem;
  transition: color 0.3s ease;
}

.nav-link:hover, .nav-link.active {
  color: var(--secondary-color) !important;
}

/* Hero Section with custom flex centering */
.hero-section {
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.65)), 
              url('https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1920') no-repeat center center/cover;
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
}

.hero-btn {
  background-color: var(--primary-color);
  color: #fff;
  border: 1px solid var(--primary-color);
  padding: 0.75rem 2rem;
  border-radius: 0;
  font-weight: 600;
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

.hero-btn:hover {
  background-color: transparent;
  color: #fff;
  border-color: #fff;
}

/* Cards & Grid Styling */
.section-padding {
  padding: 6rem 0;
}

.section-title {
  position: relative;
  margin-bottom: 3rem;
  color: var(--dark-color);
}

.section-title::after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background-color: var(--secondary-color);
  margin: 10px auto 0;
}

.menu-card {
  border: none;
  background-color: #fff;
  border-radius: 0;
  box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.menu-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0,0,0,0.08);
}

.menu-card img {
  border-radius: 0;
  height: 240px;
  object-fit: cover;
}

.menu-price {
  color: var(--primary-color);
  font-weight: 700;
  font-size: 1.25rem;
}

/* About Us custom layout */
.about-img {
  box-shadow: 20px 20px 0 var(--secondary-color);
  object-fit: cover;
  height: 400px;
  width: 100%;
}

/* Contact Form styling */
.form-control {
  border-radius: 0;
  border: 1px solid #e2dcd8;
  padding: 0.75rem 1rem;
  background-color: #fff;
}

.form-control:focus {
  border-color: var(--primary-color);
  box-shadow: none;
}

.submit-btn {
  background-color: var(--dark-color);
  color: #fff;
  border-radius: 0;
  padding: 0.75rem 2.5rem;
  font-weight: 600;
  border: none;
  transition: background-color 0.3s ease;
}

.submit-btn:hover {
  background-color: var(--primary-color);
}

/* Footer styling */
footer {
  background-color: var(--dark-color);
  color: #b0a59e;
  padding: 3rem 0;
}

footer a {
  color: #b0a59e;
  font-size: 1.25rem;
  transition: color 0.3s ease;
}

footer a:hover {
  color: var(--secondary-color);
}
